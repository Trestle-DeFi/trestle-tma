{
  "name": "trestle-setforget-contracts",
  "version": "1.0.0",
  "description": "Set & Forget smart contracts for Reactive Omni Buildathon - Version 37 - Enhanced with Per-User Configuration Support",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:baseSepolia": "hardhat run scripts/deploy-mainvault.js --network baseSepolia",
    "deploy:unichainSepolia": "hardhat run scripts/deploy-subaccount.js --network unichainSepolia",
    "deploy:lasna": "hardhat run scripts/deploy-reactiveguard.js --network lasnaTestnet",
    "deploy:ccipBridge": "hardhat run scripts/deploy-ccipbridge.js --network baseSepolia",
    "deploy:ccipReceiver": "hardhat run scripts/deploy-ccipreceiver.js --network unichainSepolia",
    "setup:unichainSepolia": "hardhat run scripts/setup-unichain.js --network unichainSepolia",
    "setup:baseSepolia": "hardhat run scripts/setup-baseSepolia.js --network baseSepolia",
    "setup:lasna": "hardhat run scripts/setup-lasna.js --network lasnaTestnet",
    "setup:crosschain": "hardhat run scripts/setup-crosschain.js --network lasnaTestnet",
    "setup:user": "hardhat run scripts/setup-user.js --network baseSepolia",
    "deploy:all": "hardhat run scripts/deploy-all.js",
    "test": "forge test",
    "test:foundry": "forge test",
    "verify:baseSepolia": "hardhat verify --network baseSepolia --contract src/TrestleMainVault.sol:TrestleMainVault DEPLOYED_CONTRACT_ADDRESS",
    "verify:unichainSepolia": "hardhat verify --network unichainSepolia --contract src/TrestleSubAccount.sol:TrestleSubAccount DEPLOYED_CONTRACT_ADDRESS",
    "verify:lasna": "hardhat verify --network lasnaTestnet --contract src/TrestleReactiveGuard.sol:TrestleReactiveGuard DEPLOYED_CONTRACT_ADDRESS",
    "verify:all:baseSepolia": "hardhat run scripts/verify-all.js --network baseSepolia",
    "verify:all:unichainSepolia": "hardhat run scripts/verify-all.js --network unichainSepolia",
    "verify:all:lasna": "hardhat run scripts/verify-all.js --network lasnaTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.3",
    "@nomicfoundation/hardhat-foundry": "^3.0.5",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-verify": "^3.1.5",
    "dotenv": "^18.0.10",
    "hardhat": "^3.23.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@reactive/reactive-lib-omni": "file:lib/reactive-lib-omni",
    "fp-ts": "^2.16.11",
    "io-ts": "^2.2.22"
  },
  "allowScripts": {
    "esbuild": true,
    "keccak": true,
    "secp256k1": true
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
