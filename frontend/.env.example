# Frontend environment — copy to .env.local and fill in real values
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
VITE_REWARD_API_URL=https://reward-api.trestle.website
VITE_VAULT_API_URL=https://vault.trestle.website
VITE_AI_API_URL=https://ai.trestle.website
VITE_SITE_URL=https://trestle.website
VITE_MAIN_SITE_URL=https://trestle.website
VITE_TESTNET_URL=https://testnet.trestle.website
# Optional: Blockscout PRO API key — adds a premium RPC to the multi-rpc pool
# (also accepted under the alias VITE_PUBLIC_BLOCKSCOUT_API_KEY)
VITE_BLOCKSCOUT_API_KEY=
