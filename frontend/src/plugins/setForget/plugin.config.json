{
  "name": "setForget-plugin",
  "version": "1.0.0",
  "description": "Set & Forget auto-topup plugin with per-user configuration management",
  "author": "Trestle DeFi",
  "license": "MIT",
  "tags": ["automation", "gas-management", "reactive", "configuration"],
  "dependencies": ["wallet-connect", "contracts"],
  "permissions": ["read:subaccounts", "write:subaccounts", "callback", "read:preferences", "write:preferences"],
  "routes": [
    "/api/plugins/set-forget/subaccounts",
    "/api/plugins/set-forget/reactive/subscription",
    "/api/plugins/set-forget/reactive/status",
    "/api/plugins/set-forget/reactive/callback",
    "/api/plugins/set-forget/configuration/preferences",
    "/api/plugins/set-forget/configuration/history"
  ],
  "networkConfig": {
    "baseSepolia": {
      "chainId": 84532,
      "rpcUrl": "https://sepolia.base.org",
      "contract": "TrestleMainVault",
      "contractAddress": "0xd8FD13A95e54640206167d31bb39eF5FfF5dF231",
      "explorer": "https://sepolia.basescan.org",
      "role": "origin",
      "purpose": "Main vault for reserve funds"
    },
    "unichainSepolia": {
      "chainId": 1301,
      "rpcUrl": "https://sepolia.unichain.org",
      "contract": "TrestleSubAccount",
      "contractAddress": "0xf4Fef25b23171586E8C87994B8f3D1a3AfCe4c71",
      "explorer": "https://unichain-sepolia.blockscout.com",
      "role": "destination",
      "purpose": "Operational sub-account for escrows"
    },
    "lasnaTestnet": {
      "chainId": 5318007,
      "rpcUrl": "https://lasna-rpc.rnk.dev/",
      "contract": "TrestleReactiveGuard",
      "contractAddress": "0x27fcAdD5142ECB1b6FC13314a2bDfB71dC92CeF3",
      "explorer": "https://lasna.reactscan.net",
      "role": "reactive",
      "purpose": "Reactive subscription and callback triggering"
    }
  },
  "api": {
    "baseUrl": "https://vault.trestle.website",
    "note": "Plugin routes are served by the trestle-vault worker, not the reward API."
  },
  "crossChainFlow": "Unichain Sepolia (SubAccount) -> Lasna Testnet (ReactiveGuard) -> Base Sepolia (MainVault)",
  "hackathon": "Reactive Omni Buildathon",
  "hackathonVersion": "37",
  "configuration": {
    "features": [
      "per-user-threshold-management",
      "auto-topup-configuration",
      "risk-level-settings",
      "gas-optimization",
      "notification-preferences",
      "configuration-history",
      "backup-and-restore"
    ],
    "userPreferences": {
      "autoTopupEnabled": true,
      "notificationsEnabled": true,
      "riskLevel": "medium",
      "gasOptimization": true
    },
    "subAccountSettings": {
      "defaultThreshold": "0.01",
      "defaultTarget": "0.05",
      "defaultCooldown": 300,
      "defaultMaxDaily": 10
    },
    "bounds": {
      "minThresholdWei": "1000000000000000",
      "minCooldownSeconds": 300,
      "maxDaily": 1000
    },
    "note": "Defaults and bounds are deployment settings; every value is stored and applied per user address."
  }
}